# Copy to .env and change a value if that port is already in use on your machine.
# docker compose reads .env automatically.
APP_PORT=18080
KAFKA_UI_PORT=18081
KAFKA_PORT=19092

# AI assistant: ollama (local, default) | anthropic (needs ANTHROPIC_API_KEY) | none
SPRING_AI_MODEL_CHAT=ollama
OLLAMA_MODEL=qwen2.5:3b
# ANTHROPIC_API_KEY=
